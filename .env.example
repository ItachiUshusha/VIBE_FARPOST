# Docker Compose: скопируйте в .env при необходимости изменить порты.
FRONTEND_PORT=3000
BACKEND_PORT=8000
MONGODB_DATABASE=farpost_butterfly

# Для запуска Python без Docker (из корня проекта):
MONGODB_URI=mongodb://127.0.0.1:27017
DATASET_VERSION=pervaya-rechka-v1
AUTO_SEED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js проксирует /api в FastAPI. В Docker адрес задан build-аргументом.
API_PROXY_URL=http://127.0.0.1:8000

# Единый адрес в браузере. HTTP допустим только для localhost/127.0.0.1.
PUBLIC_ORIGIN=http://localhost:3000
SESSION_DAYS=7
REPORT_TIMEZONE=Asia/Vladivostok
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID OAuth 2.1 + PKCE: секрет приложения для этого потока не требуется.
VK_CLIENT_ID=

# Номер счётчика публичный; токен чтения хранится только в backend.
METRICA_COUNTER_ID=
METRICA_READ_TOKEN=
METRICA_REGISTRATION_GOAL_ID=
METRICA_LOGIN_GOAL_ID=
METRICA_SIMULATION_GOAL_ID=
ANALYTICS_UTM_ALLOWLIST='{"utm_source":["yandex","vk","google"],"utm_medium":["cpc","organic","social"],"utm_campaign":["launch"]}'

# auto: публиковать утверждённый комплект из поставки без настройки версии.
# disabled: отключить публикацию. manual: использовать два параметра ниже.
LEGAL_PUBLICATION_MODE=auto
# Эти параметры применяются только в режиме manual.
LEGAL_PUBLISHED=true
LEGAL_VERSION=2026-11-14-brand-402x402
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Для compose.production.yaml и автоматического HTTPS (домен без схемы).
SITE_DOMAIN=
